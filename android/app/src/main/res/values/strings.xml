    <string name="promotion_body">No action needed. Ignore it, or block the sender if you do not want these.</string>
    <string name="promotion_advice">Promotion: no action needed. Ignore it, or block the sender if you do not want these.\n1. You do not need to reply or call.\n2. Never share an OTP, PIN or password, even with a shop.\n3. Block the sender if these messages bother you.</string>
    <string name="advice_scam_intro">This message looks like a scam. It contains suspicious cues and untrusted links that may be attempting fraud. Do not trust the sender.</string>
    <string name="advice_scam_step1">Do not click or open any links in the message.</string>
    <string name="advice_scam_step2">Verify the request independently using the official app or by typing the official website.</string>
    <string name="advice_scam_step3">Report the scam to cybercrime.gov.in, call 1930, or report on Sanchar Saathi (Chakshu).</string>
    <string name="advice_unwanted_intro">This message looks like unwanted promotional or spam content. It may contain unsolicited offers. Exercise caution before responding.</string>
    <string name="advice_unwanted_step1">Do not share any personal details, PINs, or OTPs.</string>
    <string name="advice_unwanted_step2">Verify any unexpected offers through official channels.</string>
    <string name="advice_unwanted_step3">Block the sender or mark the message as spam.</string>
    <string name="advice_safe_intro">This message appears to be low risk. The sender and any detected links look consistent with normal communications.</string>
    <string name="advice_safe_step1">Still verify any unexpected requests independently.</string>
    <string name="advice_safe_step2">Never share your password, PIN, or OTP with anyone.</string>
    <string name="advice_safe_step3">Access official services only through official apps or verified websites.</string>
    <string name="advice_promotion_intro">Promotion: no action needed. Ignore it, or block the sender if you do not want these.</string>
    <string name="advice_promotion_step1">You do not need to reply or call.</string>
    <string name="advice_promotion_step2">Never share an OTP, PIN or password, even with a shop.</string>
