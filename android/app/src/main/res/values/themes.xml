<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PS3Sentinel" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textViewStyle">@style/Widget.Sentinel.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Sentinel.EditText</item>
        <item name="android:buttonStyle">@style/Widget.Sentinel.Button.Glass</item>
        <item name="buttonStyle">@style/Widget.Sentinel.Button.Glass</item>
        <item name="android:windowBackground">@drawable/bg_app_glass</item>
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="textAppearanceHeadline1">@style/TextAppearance.Sentinel.DisplayXL</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Sentinel.DisplayL</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Sentinel.HeadingM</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Sentinel.BodyL</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Sentinel.BodyM</item>
    </style>

    <style name="Widget.Sentinel.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="Widget.Sentinel.EditText" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.Sentinel.DisplayXL" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">40sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.DisplayL" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">30sp</item>
        <item name="android:lineSpacingMultiplier">1.13</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.HeadingM" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.BodyL" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.BodyM" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.LabelM" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.29</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.LabelS" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.33</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="TextAppearance.Sentinel.MonoM" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.38</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Sentinel.MonoS" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingMultiplier">1.27</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="Widget.Sentinel.Button.Glass" parent="Widget.MaterialComponents.Button">
        <item name="background">@drawable/bg_liquid_button</item>
        <item name="android:background">@drawable/bg_liquid_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="iconTint">#FFFFFFFF</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Sentinel.Button.Primary" parent="Widget.Sentinel.Button.Glass" />

    <style name="Widget.Sentinel.Button.Secondary" parent="Widget.Sentinel.Button.Glass" />

    <style name="Widget.Sentinel.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/surface_2</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="Widget.Sentinel.Chip.Brand" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/brand_deep</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="Widget.Sentinel.Card.Glass" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
