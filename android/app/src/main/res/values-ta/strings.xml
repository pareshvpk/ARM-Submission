    <string name="settings_notifications_turn_on">அறிவிப்புகளை இயக்கவும்</string>
    <string name="settings_notifications_disclaimer">அறிவிப்புகள் இல்லாமல், மோசடி SMS வரும்போது Sentinel உங்களை எச்சரிக்க முடியாது. நீங்கள் செயலியில் எந்தச் செய்தியையும் நீங்களே சரிபார்க்கலாம்.</string>
    <string name="dialog_open_settings">அமைப்புகளைத் திற</string>
    <string name="dialog_not_now">இப்போது வேண்டாம்</string>
    <string name="app_access_title">செயலி அணுக்கச் சரிபார்ப்பு</string>
    <string name="app_access_explanation">Accessibility மூலம் உங்கள் திரையைப் படிக்கக்கூடிய அல்லது உங்களுக்காகச் செயல்படக்கூடிய செயலிகளைப் பட்டியலிடுகிறது. மோசடி செயலிகள் பெரும்பாலும் இதைத்தான் கேட்கும்.</string>
    <string name="app_access_button">இப்போது சரிபார்</string>
    <string name="app_access_none">எந்தச் செயலிக்கும் Accessibility அணுக்கம் இல்லை.</string>
    <string name="app_access_flag_screen">திரையைப் படிக்க முடியும்</string>
    <string name="app_access_flag_gestures">உங்களுக்காகத் தட்டச்சு மற்றும் தட்ட முடியும்</string>
    <string name="app_access_flag_sms">SMS படிக்க முடியும்</string>
    <string name="app_access_flag_sms_unknown">SMS அனுமதி தெரியவில்லை</string>
    <string name="app_access_flag_system">சிஸ்டம் செயலி</string>
    <string name="app_access_disclaimer">இது செயலிகளுக்கு என்ன அனுமதி உள்ளது என்பதைக் காட்டுகிறது, மால்வேர் என்பதற்கான ஆதாரம் அல்ல. உங்களுக்குத் தெரியாத அணுக்கத்தை Android அமைப்புகள், Accessibility என்பதில் முடக்கவும்.</string>
    <string name="app_access_error">இந்த ஃபோனில் செயலிகளைச் சரிபார்க்க முடியவில்லை.</string>
    <string name="screen_check_no_text">திரையில் சரிபார்க்க உரை எதுவும் கிடைக்கவில்லை.</string>
    <string name="screen_check_service_description">அணுகல்தன்மை பட்டனைத் தட்டும்போது மட்டுமே திரையைப் படிக்கும், ஃபோனிலேயே சரிபார்க்கும், எதையும் சேமிக்காது.</string>
    <string name="screen_check_service_summary">தேவைப்படும்போது திரையில் உள்ள உரையைச் சரிபார்க்கவும். பின்னணியில் எதுவும் படிக்கப்படாது, எங்கும் அனுப்பப்படாது.</string>
    <string name="settings_screen_check_title">இந்தத் திரையைச் சரிபார்</string>
    <string name="settings_screen_check_explanation">எந்தச் செயலிலும் சந்தேகமான செய்தி திரையில் இருக்கும்போது, அணுகல்தன்மை பட்டனைத் தட்டி Sentinel மூலம் சரிபார்க்கலாம். பட்டனைத் தட்டும்போது மட்டுமே திரையைப் படிக்கும், இந்த ஃபோனிலேயே சரிபார்க்கும், எதையும் சேமிக்காது.</string>
