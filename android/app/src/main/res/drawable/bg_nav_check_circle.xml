<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="64dp"
                android:height="64dp" />
            <gradient
                android:angle="315"
                android:startColor="#F2C7EDFF"
                android:endColor="#F24D80FF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
