<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Base fill with 1dp stroke #29FFFFFF -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_bar_surface" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
            <corners android:radius="34dp" />
        </shape>
    </item>

    <!-- 2. Inner 1dp top highlight #2E8FC4FF (blue) -->
    <item
        android:height="1dp"
        android:left="34dp"
        android:right="34dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#2E8FC4FF" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>
