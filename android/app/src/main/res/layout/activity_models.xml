<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glass"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text"
        app:title="@string/models_title"
        app:titleTextColor="@color/text" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. SMS Classifier Card -->
            <LinearLayout
                android:id="@+id/cardSmsModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/model_sms_title"
                        android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvSmsStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_risk_low"
                        android:fontFamily="@font/inter"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/risk_low_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSmsFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/tvSmsSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                    android:textColor="@color/text_2" />

                <TextView
                    android:id="@+id/tvSmsLengthMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                    android:textColor="@color/text_2" />

                <TextView
                    android:id="@+id/tvSmsVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.LabelS"
                    android:textColor="@color/text_3"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2. URL Classifier Card -->
            <LinearLayout
                android:id="@+id/cardUrlModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/model_url_title"
                        android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvUrlStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_risk_low"
                        android:fontFamily="@font/inter"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/risk_low_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUrlFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/tvUrlSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                    android:textColor="@color/text_2" />

                <TextView
                    android:id="@+id/tvUrlVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.LabelS"
                    android:textColor="@color/text_3"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 3. Llama 3.2 1B Instruct Card -->
            <LinearLayout
                android:id="@+id/cardLlamaModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/model_llama_card_title"
                        android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvLlamaStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_risk_low"
                        android:fontFamily="@font/inter"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/risk_low_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLlamaFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/tvLlamaSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                    android:textColor="@color/text_2" />
            </LinearLayout>

            <!-- 4. Integrity Check Result Card -->
            <LinearLayout
                android:id="@+id/cardIntegrity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/model_integrity_title"
                        android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvIntegrityStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_risk_low"
                        android:fontFamily="@font/inter"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/risk_low_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvIntegrityDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter"
                    android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                    android:textColor="@color/text_2" />
            </LinearLayout>

            <!-- 5. Arm CPU Card -->
            <LinearLayout
                android:id="@+id/cardCpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/model_cpu_title"
                    android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                    android:textColor="@color/text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:text="@string/cpu_dotproduct_label"
                        android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvCpuDotProduct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                        android:textColor="@color/text_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:text="@string/cpu_i8mm_label"
                        android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvCpuI8mm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                        android:textColor="@color/text_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:text="@string/cpu_sme2_label"
                        android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvCpuSme2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                        android:textColor="@color/text_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:text="@string/cpu_kernel_path_label"
                        android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/tvCpuKernelPath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textAppearance="@style/TextAppearance.Sentinel.MonoM"
                        android:textColor="@color/brand" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
