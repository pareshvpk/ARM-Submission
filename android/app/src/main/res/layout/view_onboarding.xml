<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glass"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/onboardingPage1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/onboarding_chip_offline"
                android:textAppearance="@style/TextAppearance.Sentinel.LabelS"
                android:textColor="@color/text_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_brand"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/onboarding_chip_languages"
                android:textAppearance="@style/TextAppearance.Sentinel.LabelS"
                android:textColor="@color/brand" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/viewOnboardingGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/onboarding_headline"
                android:src="@drawable/ic_shield_stroke"
                app:tint="@color/brand" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/space_grotesk"
            android:text="@string/onboarding_headline"
            android:textAppearance="@style/TextAppearance.Sentinel.DisplayL"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:text="@string/onboarding_body"
            android:textAppearance="@style/TextAppearance.Sentinel.BodyL"
            android:textColor="@color/text_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <View
                android:id="@+id/onboardingDot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_pager_dot"
                android:backgroundTint="@color/brand" />

            <View
                android:id="@+id/onboardingDot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pager_dot" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowSmsAccess"
            style="@style/Widget.Sentinel.Button.Glass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/onboarding_allow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotNow"
            style="@style/Widget.Sentinel.Button.Glass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/onboarding_not_now" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onboardingPage2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_ring">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@string/privacy_headline"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/brand" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/space_grotesk"
            android:text="@string/privacy_headline"
            android:textAppearance="@style/TextAppearance.Sentinel.DisplayL"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:text="@string/privacy_body"
            android:textAppearance="@style/TextAppearance.Sentinel.BodyL"
            android:textColor="@color/text_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/privacy_row1_title"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/privacy_row1_title"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.Sentinel.LabelM"
                    android:textColor="@color/text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/privacy_row1_body"
                    android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                    android:textColor="@color/text_2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/privacy_row2_title"
                android:src="@drawable/ic_cpu"
                app:tint="@color/brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/privacy_row2_title"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.Sentinel.LabelM"
                    android:textColor="@color/text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/privacy_row2_body"
                    android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                    android:textColor="@color/text_2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/privacy_row3_title"
                android:src="@drawable/ic_lock"
                app:tint="@color/brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/privacy_row3_title"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.Sentinel.LabelM"
                    android:textColor="@color/text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/privacy_row3_body"
                    android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                    android:textColor="@color/text_2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="@string/privacy_permissions"
            android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
            android:textColor="@color/text_3" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnboardingContinue"
            style="@style/Widget.Sentinel.Button.Glass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/onboarding_continue" />
    </LinearLayout>
</LinearLayout>
