<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLinkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_risk_high"
            android:fontFamily="@font/inter"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="UNTRUSTED"
            android:textColor="@color/risk_high_text"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLinkProb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono"
            android:text="Prob: 0.85"
            android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
            android:textColor="@color/text_2" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLinkUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:autoLink="none"
        android:fontFamily="@font/jetbrains_mono"
        android:linksClickable="false"
        android:text="https://example.com"
        android:textAppearance="@style/TextAppearance.Sentinel.MonoM"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/tvLinkIndicators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Indicators: brand_lookalike, risky_tld"
        android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
        android:textColor="@color/text_3"
        android:visibility="gone" />
</LinearLayout>
