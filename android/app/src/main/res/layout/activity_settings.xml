<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            app:title="@string/settings_title"
            app:titleTextColor="@color/text" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="112dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Language Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/settings_language_title"
                            android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                            android:textColor="@color/text" />

                        <RadioGroup
                            android:id="@+id/rgLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbSystem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/language_system"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbEnglish"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/language_english"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbHindi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/language_hindi"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbTamil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/language_tamil"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Check this screen Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardScreenCheck"
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/settings_screen_check_title"
                            android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                            android:textColor="@color/text" />

                        <TextView
                            android:id="@+id/tvScreenCheckExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/settings_screen_check_explanation"
                            android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                            android:textColor="@color/text" />

                        <TextView
                            android:id="@+id/tvScreenCheckStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter"
                            android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                            android:textColor="@color/text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScreenCheckSettings"
                            style="@style/Widget.Sentinel.Button.Glass"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:minHeight="48dp"
                            android:text="@string/settings_screen_check_button" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Usage guide Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUsageGuide"
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk"
                                android:text="@string/menu_usage_guide"
                                android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                                android:textColor="@color/text" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter"
                                android:text="@string/tile_guide_sub"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text_2" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_box">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:rotation="180"
                                android:src="@drawable/ic_arrow_back"
                                app:tint="@color/brand" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Notifications Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNotifications"
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/settings_notifications_title"
                            android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                            android:textColor="@color/text" />

                        <TextView
                            android:id="@+id/tvNotificationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter"
                            android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                            android:textColor="@color/text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTurnOnNotifications"
                            style="@style/Widget.Sentinel.Button.Glass"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:minHeight="48dp"
                            android:text="@string/settings_notifications_turn_on" />

                        <TextView
                            android:id="@+id/tvNotificationDisclaimer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/settings_notifications_disclaimer"
                            android:textAppearance="@style/TextAppearance.Sentinel.LabelS"
                            android:textColor="@color/text_2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Storage Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/settings_storage_title"
                            android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                            android:textColor="@color/text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter"
                                android:text="@string/storage_app"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />

                            <TextView
                                android:id="@+id/tvStorageApp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/storage_calculating"
                                android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                                android:textColor="@color/text_2" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter"
                                android:text="@string/storage_models"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />

                            <TextView
                                android:id="@+id/tvStorageModels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/storage_calculating"
                                android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                                android:textColor="@color/text_2" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter"
                                android:text="@string/storage_other"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text" />

                            <TextView
                                android:id="@+id/tvStorageOther"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/storage_calculating"
                                android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                                android:textColor="@color/text_2" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter"
                                android:text="@string/storage_total"
                                android:textAppearance="@style/TextAppearance.Sentinel.LabelM"
                                android:textColor="@color/text" />

                            <TextView
                                android:id="@+id/tvStorageTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/storage_calculating"
                                android:textAppearance="@style/TextAppearance.Sentinel.MonoM"
                                android:textColor="@color/text" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="@string/storage_uninstall_note"
                            android:textAppearance="@style/TextAppearance.Sentinel.LabelS"
                            android:textColor="@color/text_3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowWelcomeGuide"
                    style="@style/Widget.Sentinel.Button.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:minHeight="48dp"
                    android:text="@string/settings_show_welcome_guide" />

                <!-- Models Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardModels"
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk"
                                android:text="@string/models_title"
                                android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                                android:textColor="@color/text" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter"
                                android:text="@string/models_row_sub"
                                android:textAppearance="@style/TextAppearance.Sentinel.BodyM"
                                android:textColor="@color/text_2" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_box">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:rotation="180"
                                android:src="@drawable/ic_arrow_back"
                                app:tint="@color/brand" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- About Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Sentinel.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:text="@string/settings_about_title"
                            android:textAppearance="@style/TextAppearance.Sentinel.HeadingM"
                            android:textColor="@color/text" />

                        <TextView
                            android:id="@+id/tvVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.Sentinel.MonoS"
                            android:textColor="@color/text_2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <include
        android:id="@+id/bottomBar"
        layout="@layout/view_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom" />

</FrameLayout>
